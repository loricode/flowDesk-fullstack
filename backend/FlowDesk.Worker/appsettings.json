{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "ConnectionStrings": {
    "FlowDesk": "Data Source=flowdesk.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "../.data/storage",
    "BucketName": "flowdesk-documents"
  },
  "Messaging": {
    "Provider": "InProcess",
    "QueueUrl": null,
    "PollingIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 5
  },
  "AWS": {
    "Region": "us-east-1",
    "ServiceURL": ""
  },
  "RealtimeRelay": {
    "ApiBaseUrl": "http://localhost:5080",
    "InternalApiKey": ""
  }
}
