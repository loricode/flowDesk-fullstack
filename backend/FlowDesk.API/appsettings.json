{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FlowDesk": "Data Source=flowdesk.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "EnsureCreated": true,
    "SeedDemoData": true
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "../.data/storage",
    "BucketName": "flowdesk-documents"
  },
  "Messaging": {
    "Provider": "InProcess",
    "QueueUrl": null
  },
  "AWS": {
    "Region": "us-east-1",
    "ServiceURL": ""
  },
  "Jwt": {
    "Issuer": "FlowDesk",
    "Audience": "FlowDesk.Clients",
    "SigningKey": "",
    "ExpiresMinutes": 480
  },
  "RealtimeRelay": {
    "InternalApiKey": ""
  },
  "Worker": {
    "RunInApi": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
