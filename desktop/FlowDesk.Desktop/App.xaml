<Application x:Class="FlowDesk.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:FlowDesk.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design 3 con la paleta FlowDesk: sapote como primario, negro azulado como secundario -->
                <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#D9734E" SecondaryColor="#1B2533" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/FlowDeskTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
            <conv:ItemStateToBrushConverter x:Key="ItemStateToBrush" />
            <conv:ItemStateToIconConverter x:Key="ItemStateToIcon" />
            <conv:LabelConverter x:Key="Label" />
            <conv:PriorityToBrushConverter x:Key="PriorityToBrush" />
            <conv:TintConverter x:Key="Tint" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
