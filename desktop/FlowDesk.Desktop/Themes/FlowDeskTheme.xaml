<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        Paleta FlowDesk (compartida con la web: frontend/packages/ui-components/src/theme.ts)
        Sapote ......... #D9734E  primario (acciones, foco, progreso)
        Gris agradable . #EEF0F3  fondo de la aplicación / #E1E5EA bordes / #6B7480 texto secundario
        Negro azulado .. #1B2533  encabezado, barra lateral y texto principal
    -->
    <Color x:Key="SapoteColor">#D9734E</Color>
    <Color x:Key="SapoteLightColor">#F6D3C4</Color>
    <Color x:Key="SapoteDarkColor">#B0532F</Color>
    <Color x:Key="InkColor">#1B2533</Color>
    <Color x:Key="InkSoftColor">#273345</Color>
    <Color x:Key="InkMutedColor">#8D9AAD</Color>
    <Color x:Key="GrayBackgroundColor">#EEF0F3</Color>
    <Color x:Key="GrayBorderColor">#E1E5EA</Color>
    <Color x:Key="GrayTextColor">#6B7480</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#3E8E6A</Color>
    <Color x:Key="DangerColor">#C2453B</Color>
    <Color x:Key="InfoColor">#5B7088</Color>

    <SolidColorBrush x:Key="SapoteBrush" Color="{StaticResource SapoteColor}" />
    <SolidColorBrush x:Key="SapoteLightBrush" Color="{StaticResource SapoteLightColor}" />
    <SolidColorBrush x:Key="SapoteDarkBrush" Color="{StaticResource SapoteDarkColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMutedColor}" />
    <SolidColorBrush x:Key="GrayBackgroundBrush" Color="{StaticResource GrayBackgroundColor}" />
    <SolidColorBrush x:Key="GrayBorderBrush" Color="{StaticResource GrayBorderColor}" />
    <SolidColorBrush x:Key="GrayTextBrush" Color="{StaticResource GrayTextColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Sobrescribe los pinceles base de Material Design con la paleta -->
    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource GrayBackgroundColor}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Card.Background" Color="{StaticResource SurfaceColor}" />

    <!-- Tipografía -->
    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Overline" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignOverlineTextBlock}">
        <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Tarjeta base -->
    <Style x:Key="SurfaceCard" TargetType="materialDesign:Card">
        <Setter Property="UniformCornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
    </Style>

    <!-- Botones -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CaptureButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource GrayBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Lista de expedientes en la barra lateral oscura -->
    <Style x:Key="SidebarListItem" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="materialDesign:ListBoxItemAssist.ShowSelection" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent"
                            BorderThickness="3,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24D9734E" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SapoteBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip de estado -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
</ResourceDictionary>
