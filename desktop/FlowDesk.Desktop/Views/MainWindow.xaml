<Window x:Class="FlowDesk.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FlowDesk Capture"
        Width="1360" Height="840" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GrayBackgroundBrush}"
        TextElement.Foreground="{StaticResource InkBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:DialogHost IsOpen="{Binding IsNewExpedientOpen}" CloseOnClickAway="False"
                               DialogTheme="Light" DialogBackground="{StaticResource SurfaceBrush}">
        <!-- =============== Diálogo: nuevo expediente =============== -->
        <materialDesign:DialogHost.DialogContent>
            <StackPanel Width="460" Margin="28">
                <TextBlock Text="Nuevo expediente" Style="{StaticResource PageTitle}" />
                <TextBlock Margin="0,4,0,20" Style="{StaticResource Muted}"
                           Text="Se creará en estado «Recibido» y podrá adjuntar documentos de inmediato." />

                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                         materialDesign:HintAssist.Hint="Título de la solicitud" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBox Margin="0,14,0,0" Text="{Binding NewApplicant, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                         materialDesign:HintAssist.Hint="Solicitante (cliente, proveedor o empleado)" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <TextBox Margin="0,14,0,0" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" MaxLines="4"
                         materialDesign:HintAssist.Hint="Descripción (opcional)" Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewPriority}"
                              materialDesign:HintAssist.Hint="Prioridad" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource Label}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding AssignableUsers}" SelectedItem="{Binding NewAssignee}"
                              DisplayMemberPath="FullName"
                              materialDesign:HintAssist.Hint="Responsable (opcional)" Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                </Grid>

                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Text="{Binding NewExpedientError}"
                           Visibility="{Binding NewExpedientError, Converter={StaticResource NullToVisibility}}" />

                <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding CancelNewExpedientCommand}" />
                    <Button Margin="8,0,0,0" Content="Crear expediente" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateExpedientCommand}"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsCreatingExpedient}"
                            materialDesign:ButtonProgressAssist.IsIndeterminate="True" />
                </StackPanel>
            </StackPanel>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- =============== Encabezado (negro azulado) =============== -->
            <Border Background="{StaticResource InkBrush}" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SapoteBrush}">
                            <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="20" Height="20" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="12,0,0,0" Text="FlowDesk" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6" Background="#33D9734E" VerticalAlignment="Center">
                            <TextBlock Text="Capture" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SapoteLightBrush}" />
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource SapoteBrush}">
                            <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UserRoles}" Foreground="{StaticResource InkMutedBrush}" FontSize="11" />
                        </StackPanel>
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource InkMutedBrush}"
                                ToolTip="Cerrar sesión" Command="{Binding LogoutCommand}">
                            <materialDesign:PackIcon Kind="Logout" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- =============== Barra lateral: expediente destino =============== -->
                <Border Background="{StaticResource InkSoftBrush}">
                    <DockPanel Margin="16,20,16,16">
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                        Foreground="{StaticResource InkMutedBrush}" ToolTip="Actualizar" Command="{Binding LoadExpedientsCommand}">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>
                                <TextBlock Text="EXPEDIENTE DESTINO" Foreground="{StaticResource InkMutedBrush}" FontSize="11"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBox Margin="0,10,0,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="White" CaretBrush="White" BorderBrush="#33FFFFFF"
                                     materialDesign:HintAssist.Hint="Buscar por código, título o solicitante"
                                     materialDesign:HintAssist.Foreground="{StaticResource SapoteBrush}"
                                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource SapoteBrush}"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8" />

                            <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource SapoteLightBrush}" BorderBrush="#66D9734E"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Command="{Binding OpenNewExpedientCommand}"
                                    Visibility="{Binding CanCreateExpedient, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderPlusOutline" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="Nuevo expediente" />
                                </StackPanel>
                            </Button>

                            <ProgressBar Margin="0,12,0,0" IsIndeterminate="True" Height="3"
                                         Visibility="{Binding IsLoadingExpedients, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Bottom" Margin="4,10,0,0" FontSize="11" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"
                                   Text="Solo se muestran expedientes que admiten documentos (recibidos, en validación o con corrección solicitada)." />

                        <Grid Margin="0,14,0,0">
                            <ListBox ItemsSource="{Binding Expedients}" SelectedItem="{Binding SelectedExpedient}"
                                     ItemContainerStyle="{StaticResource SidebarListItem}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                         ToolTip="{Binding Priority, Converter={StaticResource Label}}" />
                                                <TextBlock Text="{Binding Code}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SapoteBrush}" />
                                            </DockPanel>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                                            <DockPanel Margin="0,4,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Paperclip" Width="12" Height="12" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Margin="2,0,0,0" Text="{Binding DocumentCount}" FontSize="11" Foreground="{StaticResource InkMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource InkMutedBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding ApplicantName, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource Label}}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </Grid>
                    </DockPanel>
                </Border>

                <!-- =============== Contenido: captura =============== -->
                <Grid Grid.Column="1" Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Expediente seleccionado -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="DIGITALIZACIÓN DE DOCUMENTOS" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource PageTitle}" FontSize="22"
                                   Text="Seleccione un expediente para comenzar"
                                   Visibility="{Binding HasSelectedExpedient, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasSelectedExpedient, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource PageTitle}" FontSize="22" Text="{Binding SelectedExpedient.Title}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Muted}">
                                <Run Text="{Binding SelectedExpedient.Code, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource SapoteDarkBrush}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding SelectedExpedient.ApplicantName, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding SelectedExpedient.Status, Mode=OneWay, Converter={StaticResource Label}}" />
                                <Run Text="  ·  Responsable: " />
                                <Run Text="{Binding SelectedExpedient.AssignedToName, Mode=OneWay, TargetNullValue='sin asignar'}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Zona de captura: botones + arrastrar y soltar -->
                    <materialDesign:Card Grid.Row="1" Margin="0,16,0,16" Style="{StaticResource SurfaceCard}" Padding="18"
                                         AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                        <StackPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource CaptureButton}" Command="{Binding LoadPdfCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SapoteLightBrush}">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="{StaticResource SapoteDarkBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Cargar PDF" FontWeight="SemiBold" />
                                            <TextBlock Text="Documentos digitales" FontSize="11" Foreground="{StaticResource GrayTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource CaptureButton}" Command="{Binding LoadImagesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SapoteLightBrush}">
                                            <materialDesign:PackIcon Kind="ImageMultiple" Width="20" Height="20" Foreground="{StaticResource SapoteDarkBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Cargar imágenes" FontWeight="SemiBold" />
                                            <TextBlock Text="Fotos o escaneos" FontSize="11" Foreground="{StaticResource GrayTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource CaptureButton}" Command="{Binding SelectDocumentsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource GrayBackgroundBrush}">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="20" Height="20" Foreground="{StaticResource InkBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Seleccionar documentos" FontWeight="SemiBold" />
                                            <TextBlock Text="Cualquier formato admitido" FontSize="11" Foreground="{StaticResource GrayTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Escáner TWAIN: habilitado solo cuando hay un driver configurado -->
                                <Button Style="{StaticResource CaptureButton}" Command="{Binding ScanCommand}"
                                        ToolTip="{Binding ScannerHint}" ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource InkBrush}">
                                            <materialDesign:PackIcon Kind="Scanner" Width="20" Height="20" Foreground="White"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Escanear" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource GrayTextBrush}" Text="Escáner TWAIN" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <Grid Margin="0,14,0,0" Height="54">
                                <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource SapoteBrush}" StrokeThickness="1.4"
                                           StrokeDashArray="5 4" Fill="#0DD9734E" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="TrayArrowDown" Foreground="{StaticResource SapoteBrush}" Width="22" Height="22" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="Arrastre archivos aquí" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Margin="10,0,0,0" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                               Text="PDF, PNG, JPG o TIFF · máx. 20 MB · el formato se valida antes de enviar" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="2,8,0,0" Orientation="Horizontal"
                                        Visibility="{Binding IsHotFolderEnabled, Converter={StaticResource BoolToVisibility}}">
                                <materialDesign:PackIcon Kind="FolderEyeOutline" Foreground="{StaticResource InfoBrush}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource GrayTextBrush}" VerticalAlignment="Center"
                                           Text="{Binding HotFolderLabel}" ToolTip="Los archivos que se depositen aquí entran solos a la bandeja" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Bandeja local + vista previa -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card Style="{StaticResource SurfaceCard}" Padding="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="18,16,10,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignFlatButton}" Content="Limpiar"
                                            Command="{Binding ClearCommand}" Foreground="{StaticResource GrayTextBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Documentos capturados" />
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12">
                                            <Run Text="{Binding Items.Count, Mode=OneWay}" />
                                            <Run Text=" en bandeja · " />
                                            <Run Text="{Binding PendingCount, Mode=OneWay}" />
                                            <Run Text=" por enviar" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Padding="10,0,10,10"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                                <Setter Property="Padding" Value="10" />
                                                <Setter Property="Margin" Value="0,0,0,6" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="56" Height="64" CornerRadius="8" Background="{StaticResource GrayBackgroundBrush}" ClipToBounds="True">
                                                        <Grid>
                                                            <materialDesign:PackIcon Kind="{Binding IconKind}" Width="28" Height="28" Foreground="{StaticResource SapoteBrush}"
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                     Visibility="{Binding Thumbnail, Converter={StaticResource InverseNullToVisibility}}" />
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource GrayTextBrush}">
                                                            <Run Text="{Binding Details, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                            <materialDesign:PackIcon Width="14" Height="14" VerticalAlignment="Center"
                                                                                     Kind="{Binding State, Converter={StaticResource ItemStateToIcon}}"
                                                                                     Foreground="{Binding State, Converter={StaticResource ItemStateToBrush}}" />
                                                            <TextBlock Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding StateLabel}"
                                                                       Foreground="{Binding State, Converter={StaticResource ItemStateToBrush}}" />
                                                        </StackPanel>
                                                        <ProgressBar Margin="0,6,0,0" Height="4" Value="{Binding Progress}"
                                                                     IsIndeterminate="{Binding IsProcessing, Mode=OneWay}"
                                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource GrayTextBrush}" TextWrapping="Wrap"
                                                                   Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                                            VerticalAlignment="Top" ToolTip="Quitar de la bandeja"
                                                            Foreground="{StaticResource GrayTextBrush}"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource GrayBackgroundBrush}" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileUploadOutline" Width="34" Height="34" Foreground="{StaticResource SapoteBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="La bandeja está vacía" />
                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Muted}" TextAlignment="Center"
                                                   Text="Cargue PDF o imágenes para revisarlos antes de enviarlos." />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </materialDesign:Card>

                        <!-- Vista previa -->
                        <materialDesign:Card Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="18,16,18,12">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                               Text="{Binding SelectedItem.Details}" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="Vista previa" />
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SelectedItem.FileName, TargetNullValue='Seleccione un documento de la bandeja'}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Margin="12,0,12,12" CornerRadius="10" Background="{StaticResource GrayBackgroundBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding SelectedItem.PreviewImage}" Stretch="Uniform" Margin="12"
                                               Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVisibility}}" />

                                        <!-- WebView2 es un HWND: se oculta mientras hay un diálogo abierto (airspace). -->
                                        <Grid Visibility="{Binding IsNewExpedientOpen, Converter={StaticResource InverseBoolToVisibility}}">
                                            <wv2:WebView2 x:Name="PdfViewer" Source="{Binding PreviewUri}"
                                                          Visibility="{Binding HasPdfPreview, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Visibility="{Binding SelectedItem, Converter={StaticResource InverseNullToVisibility}}">
                                            <materialDesign:PackIcon Kind="FileEyeOutline" Width="48" Height="48" Foreground="{StaticResource InkMutedBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Muted}" Text="Aquí verá el documento antes de enviarlo." />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </materialDesign:Card>
                    </Grid>

                    <!-- Barra de acción -->
                    <materialDesign:Card Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource SurfaceCard}" Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding UploadCommand}"
                                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsUploading}"
                                    materialDesign:ButtonProgressAssist.IsIndeterminate="True">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloudUploadOutline" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Run Text="Enviar " /><Run Text="{Binding PendingCount, Mode=OneWay}" /><Run Text=" documento(s)" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="Tras el envío, el servidor calcula el hash, revalida el formato y detecta duplicados. El resultado aparece en cada documento." />
                            </DockPanel>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <materialDesign:Snackbar Grid.Row="1" MessageQueue="{Binding Notifications.Queue}" HorizontalAlignment="Center" />
        </Grid>
    </materialDesign:DialogHost>
</Window>
