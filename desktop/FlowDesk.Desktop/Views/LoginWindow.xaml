<Window x:Class="FlowDesk.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="FlowDesk Capture · Iniciar sesión"
        Width="900" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource GrayBackgroundBrush}"
        TextElement.Foreground="{StaticResource InkBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel de marca: negro azulado con acento sapote -->
        <Border Background="{StaticResource InkBrush}">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource SapoteBrush}">
                        <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="24" Height="24" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FlowDesk" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="CAPTURE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SapoteBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Digitalice y envíe documentos a sus expedientes."
                               FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Margin="0,16,0,0" FontSize="14" Foreground="{StaticResource InkMutedBrush}" TextWrapping="Wrap"
                               Text="Cargue PDF e imágenes, valide su formato antes de enviar y siga el procesamiento en tiempo real." />

                    <StackPanel Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="FilePdfBox" Foreground="{StaticResource SapoteBrush}" Width="20" Height="20" />
                            <TextBlock Margin="10,0,0,0" Foreground="White" Text="PDF, PNG, JPG y TIFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="ShieldCheck" Foreground="{StaticResource SapoteBrush}" Width="20" Height="20" />
                            <TextBlock Margin="10,0,0,0" Foreground="White" Text="Validación de firma y duplicados" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Scanner" Foreground="{StaticResource SapoteBrush}" Width="20" Height="20" />
                            <TextBlock Margin="10,0,0,0" Foreground="White" Text="Preparado para escáneres TWAIN" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock VerticalAlignment="Bottom" FontSize="11" Foreground="{StaticResource InkMutedBrush}"
                           Text="Enterprise Document &amp; Workflow Management Platform" />
            </Grid>
        </Border>

        <!-- Formulario -->
        <materialDesign:Card Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="56,64" Padding="36">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Iniciar sesión" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Margin="0,6,0,24" Style="{StaticResource Muted}" Text="Use sus credenciales corporativas." />

                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Correo electrónico"
                         materialDesign:TextFieldAssist.LeadingIcon="EmailOutline"
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                <PasswordBox x:Name="PasswordInput" Margin="0,16,0,0"
                             materialDesign:HintAssist.Hint="Contraseña"
                             materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" />

                <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="8" Background="#14C2453B"
                        Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="300" />
                    </StackPanel>
                </Border>

                <Button Margin="0,24,0,0" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                        Click="OnLoginClick" IsDefault="True"
                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsBusy}"
                        materialDesign:ButtonProgressAssist.IsIndeterminate="True">
                    <TextBlock Text="Ingresar" />
                </Button>

                <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ServerNetwork" Foreground="{StaticResource GrayTextBrush}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource GrayTextBrush}" Text="{Binding ServerUrl}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
